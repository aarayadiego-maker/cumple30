# Supabase (se obtienen en supabase.com -> tu proyecto -> Settings -> API)
# VITE_SUPABASE_ANON_KEY es la clave PUBLICA ("anon public"), segura para
# el frontend porque Row Level Security limita lo que puede hacer.
# NUNCA pongas aquí la "service_role key" (esa es secreta, server-only).
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-public-key
